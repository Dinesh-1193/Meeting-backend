# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit (Cloud dashboard or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# Optional: auto-create personal room rows on first login
ENABLE_PERSONAL_ROOMS=true

# Optional: guest JWT signing secret (defaults to service role key)
# GUEST_JWT_SECRET=

# Optional: Resend for meeting invite emails (logs to console if unset)
# RESEND_API_KEY=
EMAIL_FROM=MeetSpace <onboarding@resend.dev>

# Optional: Cloudflare R2 for cloud recording (Egress) + avatars/chat uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Centrifugo (real-time chat pub/sub — see docker-compose.yml / centrifugo-config.json)
# CENTRIFUGO_TOKEN_HMAC_SECRET must exactly match token_hmac_secret_key in centrifugo-config.json.
# CENTRIFUGO_API_KEY must exactly match api_key in centrifugo-config.json.
# Leave unset to disable the persistent chat module.
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
